<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  INTERN & AI AGENT GUIDE — WHAT IS THIS FILE?
  ============================================================================
  File: backend/pom.xml
  Purpose: Maven build configuration for the Mastek Pulse Backend Core.
  Why Java 21 + Spring Boot 3.3?
    1. Java 21 enables Virtual Threads (Project Loom) so a single instance
       handles thousands of concurrent employees during the morning commute.
    2. Spring Data JPA + Flyway enforces strict database migrations, pessimistic
       row locking (SELECT ... FOR UPDATE), and transactional outbox commits.
    3. SpringDoc OpenAPI automatically serves an interactive Swagger UI at
       http://localhost:8080/swagger-ui.html for frontend & mobile developers.
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.mastek</groupId>
    <artifactId>pulse-backend</artifactId>
    <version>0.1.0-POC</version>
    <name>Mastek Pulse Core API</name>
    <description>Modular Monolith Backend for Mastek Pulse (Android, iOS, Employee Web, Publishing Portal)</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Web REST API & Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Database: Spring Data JPA + Flyway Migrations + PostgreSQL + H2 (PostgreSQL Mode for Zero-Docker Dev) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Caching (Caffeine for POC -> switches to Redis for 10,000+ user multi-node scale) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- OpenAPI 3.1 / Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>

        <!-- Testing (JUnit 5, MockMvc, AssertJ) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
